{
  "name": "portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --write . && eslint . --fix && bun run lint:css && bun run check",
    "lint:css": "stylelint \"src/**/*.css\" \"src/**/*.svelte\" --fix",
    "format": "prettier --write .",
    "test:unit": "vitest run --run",
    "coverage": "vitest run --run --coverage",
    "test": "bun run test:unit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/node": "^24.19.4",
    "@vitest/coverage-istanbul": "^4.1.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.3",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^3.5.2",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0"
  }
}
